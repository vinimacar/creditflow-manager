rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Collection: users
    match /users/{userId} {
      // Usuários podem ler seu próprio perfil OU admins podem ler qualquer perfil
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Usuários podem criar seu próprio perfil na primeira vez OU admins podem criar qualquer perfil
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Apenas admins podem alterar roles e outros dados sensíveis
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Apenas admins podem deletar usuários
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Collections de módulos financeiros: comissoesReceber, comissoesPagar, metas
    match /comissoesReceber/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerente'
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /comissoesPagar/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerente'
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /metas/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerente'
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /auditLogs/{docId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null;
    }
    
    match /notificacoes/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.usuarioId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /configuracoes_notificacoes/{docId} {
      allow read: if request.auth != null && request.auth.uid == docId;
      allow write: if request.auth != null && request.auth.uid == docId;
    }
    
    // Collections de dados (clientes, fornecedores, produtos, etc)
    match /{collection}/{document=**} {
      // Leitura: todos os usuários autenticados
      allow read: if request.auth != null;
      
      // Escrita: todos os usuários autenticados
      // (você pode customizar para restringir baseado em roles se necessário)
      allow write: if request.auth != null;
    }
  }
}
